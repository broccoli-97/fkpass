{
  "name": "fkpass",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "法考速记卷宗 (Legal-Exam Cheat-Sheet Casefile) — 专为法考打造的沉浸式复古案卷风静态高频考点速记与检索系统。",
  "homepage": "https://fkpass.pages.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/broccoli-97/fkpass.git"
  },
  "keywords": [
    "法考",
    "法律职业资格考试",
    "司法考试",
    "考点速记",
    "备考卡片",
    "案卷卡片",
    "思维导图",
    "民法",
    "刑法",
    "行政法",
    "诉讼法",
    "chinese-bar-exam",
    "legal-exam",
    "cheat-sheet",
    "flashcards",
    "study-site",
    "cloudflare-pages",
    "static-site"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "lint:js": "eslint .",
    "check:head": "node scripts/check-head.mjs",
    "lint:css": "stylelint \"src/tokens.css\" \"src/*.html\"",
    "lint:html": "html-validate \"src/*.html\"",
    "format:check": "prettier --check \"test/**/*.js\" \"scripts/**/*.mjs\" \"*.config.js\" \"*.json\" \".github/**/*.yml\"",
    "format": "prettier --write \"test/**/*.js\" \"scripts/**/*.mjs\" \"*.config.js\" \"*.json\" \".github/**/*.yml\"",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html && npm run format:check",
    "check": "npm run lint && npm run check:head && npm run check:sitemap && npm test",
    "gen:sitemap": "node scripts/gen-sitemap.mjs",
    "check:sitemap": "node scripts/gen-sitemap.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "html-validate": "^9.5.1",
    "postcss-html": "^1.7.0",
    "prettier": "^3.4.2",
    "stylelint": "^16.12.0",
    "stylelint-config-standard": "^36.0.1",
    "wrangler": "^3.99.0"
  }
}
